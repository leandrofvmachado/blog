<h1>Blog</h1>

<ul>
  <% posts.each do |post| %>
    <li>
      <a href="<%= post.slug %>.html"><%= post.title %></a>
      <time datetime="<%= post.date.iso8601 %>"><%= post.date.strftime("%d %b %Y") %></time>
      <% if post.summary %>
        <p><%= post.summary %></p>
      <% end %>
    </li>
  <% end %>
</ul>
